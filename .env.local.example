# Optionnel : active la traduction/synthèse en français des news du Feed et le conseiller IA
# (via OpenRouter, https://openrouter.ai/keys). Sans cette clé, tout reste fonctionnel mais
# en repli : résumé brut de la source (souvent en anglais), conseiller IA basé sur des mots-clés.
OPENROUTER_API_KEY=

# Notifications push (nouvelle actu dans le Feed). Clés VAPID générées une fois via
# `node -e "console.log(require('web-push').generateVAPIDKeys())"`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:toi@example.com

# Stockage des abonnements push (Vercel Blob, créé via `vercel blob create-store`).
BLOB_READ_WRITE_TOKEN=

# Secret partagé avec Vercel Cron pour sécuriser /api/cron/notify-new (Vercel l'envoie
# automatiquement en header Authorization quand cette variable est définie sur le projet).
CRON_SECRET=
